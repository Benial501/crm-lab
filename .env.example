# Endpoint che riceve il modulo contatti (POST JSON).
# Se resta vuoto si usa la funzione del sito /api/contact.
VITE_CONTACT_ENDPOINT=

# Usate da api/contact.ts (impostarle su Vercel, non nel codice).
# Chiave API di Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Casella che riceve le richieste (più indirizzi separati da virgola).
# Se resta vuota si usa support@crm-lab.it.
CONTACT_TO=
# Mittente su un dominio verificato in Resend.
CONTACT_FROM="CRM LAB <modulo@crm-lab.it>"
